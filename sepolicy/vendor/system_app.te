allow system_app surfaceflinger:binder { call transfer };

# Allow system_app to read and write to battery supply node for Bypass Charging
allow system_app vendor_sysfs_battery_supply:dir r_dir_perms;
allow system_app vendor_sysfs_battery_supply:file rw_file_perms;

# Allow search of cgroup
allow system_app cgroup:dir search;
