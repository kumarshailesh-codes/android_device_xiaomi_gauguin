# Camera
vendor.camera.aux.packagelist=org.codeaurora.snapcam,com.android.camera,org.lineageos.aperture,org.lineageos.aperture.dev

# CNE
persist.vendor.cne.feature=1

# Dalvik
dalvik.vm.dex2oat64.enabled=true

# Data
persist.vendor.data.mode=concurrent
persist.data.netmgrd.qos.enable=true
ro.vendor.use_data_netmgrd=true

# Display
debug.sf.enable_hwc_vds=1
qemu.sf.lcd_density=440

# FUSE passthrough
persist.sys.fuse.passthrough.enable=true
ro.sys.sdcardfs=0

# HID RAW
ro.accessibility.support_hidraw=false

# IMS
persist.dbg.volte_avail_ovr=1
persist.dbg.vt_avail_ovr=0
persist.dbg.wfc_avail_ovr=1

# Media
media.settings.xml=/vendor/etc/media_profiles_vendor.xml
media.stagefright.enable-aac=true
media.stagefright.enable-fma2dp=true
media.stagefright.enable-http=true
media.stagefright.enable-player=true
media.stagefright.enable-qcp=true
media.stagefright.enable-scan=true
media.stagefright.thumbnail.prefer_hw_codecs=false

# Performance & Smoothness (Release Stability Edition)
dalvik.vm.dex2oat-filter=speed
dalvik.vm.image-dex2oat-filter=speed
dalvik.vm.dex2oat-threads=8
debug.hwui.renderer=skiagl
debug.sf.enable_gl_backpressure=1
debug.sf.disable_backpressure=0
debug.cpurend.enable=1
ro.surface_flinger.use_smart_90_for_video=true
ro.surface_flinger.set_idle_timer_ms=100
ro.surface_flinger.set_touch_timer_ms=200
ro.surface_flinger.set_display_power_timer_ms=1000
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.has_wide_color_display=true
ro.surface_flinger.has_HDR_display=true
persist.sys.use_dithering=0
persist.sys.ui.hw=1
persist.sys.binary_xml=true

# Ultra-Touch
touch.device.resample=1
ro.screen.home_res.touch=1
ro.product.multi_touch_enabled=true
ro.product.max_num_touch_points=10

# Efficiency (Disable Logging)
persist.debug.wfd.enable=0
persist.sys.print_all_logs=0
config.disable_dumpheap=true
profiler.force_disable_err_rpt=1
profiler.force_disable_ulog=1

# UX Improvements
ro.config.vc_call_vol_steps=15
ro.config.media_vol_steps=30
ro.config.hw_quickpoweron=true

# Background Optimization
pm.dexopt.bg-dexopt=speed-profile
pm.dexopt.boot=verify
pm.dexopt.install=speed-profile

# HWUI
ro.hwui.texture_cache_size=72
ro.hwui.layer_cache_size=48
ro.hwui.r_buffer_cache_size=8
ro.hwui.path_cache_size=32
ro.hwui.gradient_cache_size=1
ro.hwui.drop_shadow_cache_size=6
ro.hwui.texture_cache_flushrate=0.4
ro.hwui.text_small_cache_width=1024
ro.hwui.text_small_cache_height=1024
ro.hwui.text_large_cache_width=2048
ro.hwui.text_large_cache_height=1024

# Network
net.tcp.2g_init_rwnd=10
net.tcp.3g_init_rwnd=20
net.tcp.gprs_init_rwnd=10
net.tcp.hsdpa_init_rwnd=20
net.tcp.hspa_init_rwnd=20
net.tcp.hspap_init_rwnd=20
net.tcp.umts_init_rwnd=20
net.tcp.wifi_init_rwnd=20
net.tcp.lte_init_rwnd=20
persist.sys.tcp_cong_control=bbr

# Scrolling & Smoothness
ro.min_pointer_dur=8
windowsmgr.max_events_per_sec=150
ro.max.fling_velocity=15000
ro.min.fling_velocity=8000
persist.sys.scrolling.friction=0.005

# JIT & Runtime
dalvik.vm.jit.codecachesize=16
dalvik.vm.jit.threshold=2048
dalvik.vm.usejit=true
dalvik.vm.usejitprofiles=true

# Multitasking (LMK - Release Balanced)
ro.lmk.low=1001
ro.lmk.medium=800
ro.lmk.critical=0
ro.lmk.vmpressure_period=70
ro.lmk.upgrade_pressure=100
ro.lmk.downupgrade_pressure=10
ro.vendor.qti.config.zram=true

# GMS Optimization
ro.com.google.locationfeatures=0
ro.com.google.clientidbase=android-xiaomi
persist.sys.disable_analytics=1

# Kernel & I/O
ro.vendor.qti.core_ctl_min_cpu=2
ro.vendor.qti.core_ctl_max_cpu=4

# RIL
persist.vendor.radio.report_codec=1
ril.subscription.types=NV,RUIM
ro.telephony.default_network=33,33
ro.vendor.radio.features_common=3

# RmNet
persist.data.df.dev_name=rmnet_usb0
persist.data.wda.enable=true
persist.rmnet.data.enable=true

# Time
persist.timed.enable=true

# WiFi
wifi.interface=wlan0

# Vendor
ro.vendor.qti.va_aosp.support=1

# Stability Polish
persist.sys.perf.scroll_opt=true
persist.sys.perf.scroll_opt.heavy_app=1
vendor.display.enable_early_wakeup=1
debug.sf.enable_advanced_sf_phase_offset=1
debug.renderengine.backend=gles


# Final 100% Stability & Wi-Fi Range
persist.sys.sqlite.sync_mode=0
ro.vendor.qti.sys.fw.bg_apps_limit=60
wifi.supplicant_scan_interval=180
ro.vendor.display.sensortap=1

# Masterpiece Final Polish
ro.vendor.fingerprint.cleanup_unused_templates=1
persist.vendor.fingerprint.ignore_small_template=1
vendor.audio.offload.track.enable=true
ro.vendor.qti.sys.fw.m_mem_cap=true

# Full Power Pro Boss Tweak
sys.use_fifo_ui=1
ro.config.pinner_size=512
persist.sys.pinner.enabled=true

# Legendary Dalvik Heap Polish
dalvik.vm.heapstartsize=8m
dalvik.vm.heapgrowthlimit=256m
dalvik.vm.heapsize=512m
dalvik.vm.heaptargetutilization=0.75
dalvik.vm.heapminfree=512k
dalvik.vm.heapmaxfree=8m

# Final Production Stability
debug.hwui.use_hint_manager=true
ro.vendor.display.cabl=0
ro.adb.secure=1

# Security & Permission Polish
ro.control_privapp_permissions=enforce

# Technical Stability Injection (kl.txt fixes)
persist.vendor.wifi.sap.interface=wlan0
persist.vendor.wifi.vht80_2g=1
debug.stagefright.ccodec=1
ro.media.recorder-max-base-layer-fps=60

# Release Champion Injections
ro.surface_flinger.protected_contents=true

persist.sys.force_highend_gfx=true
ro.vendor.qti.sys.fw.bg_apps_limit=60 
ro.vendor.qti.config.zram=true                                                                                                                     
persist.vendor.qti.games.gt.prof=1

# Radio config
ro.telephony.default_network=33,33
ril.subscription.types=NV,RUIM
telephony.lteOnCdmaDevice=1

# Enable 5G features and standalone/non-standalone modes
ro.telephony.5g_capabilities=1

# Qualcomm RIL and Data NR configurations
persist.vendor.radio.5g_mode_pref=3
persist.vendor.radio.5g_num_rdds=2
persist.vendor.radio.data_con_rgs=1
persist.vendor.radio.force_on_dc=true

# Enable ENDC (E-UTRAN New Radio Dual Connectivity)
persist.vendor.radio.enable_endc=true

# Optimize signal strength and physical channel reporting for Sub6
persist.vendor.radio.anr_matching_on=1
persist.vendor.radio.sib16_support=1
persist.vendor.radio.barring_int_chk=1
