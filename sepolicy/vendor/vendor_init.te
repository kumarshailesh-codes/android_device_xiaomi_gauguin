set_prop(vendor_init, vendor_camera_prop)

allow vendor_init {
  proc_dirty
  proc
  proc_sched
}:file w_file_perms;

allow vendor_init block_device:lnk_file setattr;

# MM
allow vendor_init proc_watermark_scale_factor:file w_file_perms;

# Silence the cosmetic fingerprint_data_file getattr warning on boot
dontaudit vendor_init fingerprint_data_file:dir getattr;
