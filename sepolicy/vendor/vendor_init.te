set_prop(vendor_init, vendor_camera_prop)

allow vendor_init {
  proc_dirty
  proc
}:file w_file_perms;

allow vendor_init block_device:lnk_file setattr;

# MM
allow vendor_init proc_watermark_scale_factor:file w_file_perms;

# Fingerprint
dontaudit vendor_init fingerprint_data_file:dir getattr;

# Sched
allow vendor_init proc_sched:file w_file_perms;

# Dontaudit default_prop and bootloader_prop set attempts
dontaudit vendor_init {
  default_prop
  bootloader_prop
}:property_service set;
