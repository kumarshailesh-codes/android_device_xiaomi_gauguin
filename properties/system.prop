# Camera
vendor.camera.aux.packagelist=org.codeaurora.snapcam,com.android.camera,org.lineageos.aperture,org.lineageos.aperture.dev

# CNE
persist.vendor.cne.feature=1

# Dalvik
dalvik.vm.dex2oat64.enabled=true

# Data
persist.vendor.data.mode=concurrent
persist.data.netmgrd.qos.enable=true
ro.vendor.use_data_netmgrd=true

# Display
debug.sf.enable_hwc_vds=1
qemu.sf.lcd_density=440

# FUSE passthrough
persist.sys.fuse.passthrough.enable=false
ro.sys.sdcardfs=0

# HID RAW
ro.accessibility.support_hidraw=false

# IMS
persist.dbg.volte_avail_ovr=1
persist.dbg.vt_avail_ovr=0
persist.dbg.wfc_avail_ovr=1

# Media
media.settings.xml=/vendor/etc/media_profiles_vendor.xml
media.stagefright.enable-aac=true
media.stagefright.enable-fma2dp=true
media.stagefright.enable-http=true
media.stagefright.enable-player=true
media.stagefright.enable-qcp=true
media.stagefright.enable-scan=true
media.stagefright.thumbnail.prefer_hw_codecs=false
debug.stagefright.ccodec=4
debug.media.codec2=1
persist.media.codec2=1
ro.media.recorder-max-base-layer-fps=60

# Graphics & Performance
debug.sf.enable_gl_backpressure=1
debug.sf.disable_backpressure=0
debug.cpurend.enable=1
ro.surface_flinger.use_smart_90_for_video=true
ro.surface_flinger.set_idle_timer_ms=250
ro.surface_flinger.set_touch_timer_ms=300
ro.surface_flinger.set_display_power_timer_ms=1000

# Kernel & I/O
ro.vendor.qti.core_ctl_min_cpu=2
ro.vendor.qti.core_ctl_max_cpu=4

# RIL
persist.vendor.radio.report_codec=1
ril.subscription.types=NV,RUIM
ro.telephony.default_network=33,33
ro.vendor.radio.features_common=3

# RmNet
persist.data.df.dev_name=rmnet_usb0
persist.data.wda.enable=true
persist.rmnet.data.enable=true

# Time
persist.timed.enable=true

# WiFi
wifi.interface=wlan0

# Vendor
ro.vendor.qti.va_aosp.support=1

persist.sys.perf.scroll_opt=true
persist.sys.perf.scroll_opt.heavy_app=1
