allow platform_app surfaceflinger:binder { call transfer };

# Allow platform_app to read vendor_sysfs_graphics (FPS counter)
allow platform_app vendor_sysfs_graphics:file r_file_perms;

# Silence the cosmetic usb_uvc_enabled_prop read warning to satisfy neverallows
dontaudit platform_app usb_uvc_enabled_prop:file read;
